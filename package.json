{
  "name": "jevlin",
  "version": "0.2.0",
  "description": "Fast yes/no judgement calls for coding agents. Honest about what it can and cannot do \u2014 see the measured results before installing.",
  "type": "module",
  "bin": {
    "jevlin": "jevlin.mjs"
  },
  "files": [
    "jevlin.mjs",
    "core.mjs",
    "compare.mjs",
    "hooks/",
