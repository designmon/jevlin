    "install.sh",
    "uninstall.sh",
    "README.md",
    "SPIKE-RESULTS.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node scripts/stress.mjs && node scripts/test-redact.mjs && node scripts/test-package.mjs && node scripts/test-hooks.mjs && ./scripts/test-cli.sh",
    "bench": "node scripts/spike.mjs both",
    "bench:baseline": "node scripts/baseline.mjs"
  },
  "keywords": [
    "claude-code",
    "codex",
    "agent",
    "cli",
    "llm",
    "openrouter",
    "triage",
    "ranking"
